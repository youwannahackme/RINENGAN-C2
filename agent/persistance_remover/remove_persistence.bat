@echo off
setlocal DisableDelayedExpansion

title Agent Persistence Remover and WMI Cleanup Tool
echo ===============================================================================
echo        AGENT PERSISTENCE REMOVER AND REMEDIATION CLEANUP TOOL
echo ===============================================================================
echo.

:: 1. Check for Administrator privileges
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [!] WARNING: Administrative privileges required!
    echo     Cleaning WMI subscriptions, Scheduled Tasks, and ProgramData requires elevation.
    echo     Please right-click this script and select "Run as administrator".
    echo.
    pause
    exit /b 1
)

echo [*] Administrator privileges confirmed.
echo [*] Initializing comprehensive remediation engine...
echo.

:: 2. Execute full remediation via PowerShell engine
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference = 'SilentlyContinue'; Write-Host '[1/8] Terminating active agent and watchdog processes...' -ForegroundColor Cyan; & taskkill /F /IM securityhealthservice.exe /T 2>$null | Out-Null; & taskkill /F /IM securityhelper.exe /T 2>$null | Out-Null; & taskkill /F /IM scrcons.exe /T 2>$null | Out-Null; $killedCount = 0; $procs = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq 'securityhealthservice.exe' -or $_.Name -eq 'securityhelper.exe' -or $_.Name -eq 'scrcons.exe' -or $_.CommandLine -like '*watchdog_action*' -or $_.CommandLine -like '*SecurityHealth*' -or $_.ExecutablePath -like '*SecurityHealth*' -or $_.ExecutablePath -like '*securityhelper*' }; foreach ($p in $procs) { try { Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue; $killedCount++ } catch {} }; Start-Sleep -Milliseconds 800; Write-Host ('    [+] Processes terminated (' + $killedCount + ' process instances stopped).') -ForegroundColor Green; Write-Host '[2/8] Removing WMI Watchdog persistence subscriptions...' -ForegroundColor Cyan; $hostHash = [System.BitConverter]::ToString([System.Security.Cryptography.MD5]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes($env:COMPUTERNAME))).Replace('-','').Substring(0,10); $filterName = 'F_' + $hostHash; $consumerName = 'C_' + $hostHash; $timerName = 'T_' + $hostHash; $wmiCleaned = 0; foreach ($ns in @('root\subscription', 'root\cimv2', 'root\default')) { Get-CimInstance -Namespace $ns -ClassName __FilterToConsumerBinding -ErrorAction SilentlyContinue | Where-Object { $fStr = [string]$_.Filter; $cStr = [string]$_.Consumer; $fStr -like ('*' + $hostHash + '*') -or $fStr -like ('*' + $filterName + '*') -or $cStr -like ('*' + $hostHash + '*') -or $cStr -like ('*' + $consumerName + '*') -or $cStr -like '*watchdog_action*' } | ForEach-Object { Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue; $wmiCleaned++ }; Get-CimInstance -Namespace $ns -ClassName CommandLineEventConsumer -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $consumerName -or $_.Name -like ('*' + $hostHash + '*') -or $_.CommandLineTemplate -like '*watchdog_action*' } | ForEach-Object { Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue; $wmiCleaned++ }; Get-CimInstance -Namespace $ns -ClassName __EventFilter -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $filterName -or $_.Name -like ('*' + $hostHash + '*') -or $_.Query -like '*Win32_PerfFormattedData_PerfOS_System*' } | ForEach-Object { Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue; $wmiCleaned++ }; Get-CimInstance -Namespace $ns -ClassName __IntervalTimerInstruction -ErrorAction SilentlyContinue | Where-Object { $_.TimerId -eq $timerName -or $_.TimerId -like ('*' + $hostHash + '*') } | ForEach-Object { Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue; $wmiCleaned++ } }; Write-Host ('    [+] WMI subscriptions cleaned (' + $wmiCleaned + ' objects removed).') -ForegroundColor Green; Write-Host '[3/8] Removing Scheduled Tasks...' -ForegroundColor Cyan; $taskNames = @('Microsoft Security Health Service', 'HealthServiceRecovery', 'SecurityHealthService', 'SecurityHealthHelper'); foreach ($tn in $taskNames) { & schtasks /delete /tn $tn /f 2>$null | Out-Null }; Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -in $taskNames -or $_.Actions.Execute -like '*SecurityHealth*' -or $_.Actions.Execute -like '*securityhelper*' -or $_.Actions.Execute -like '*watchdog_action*' } | ForEach-Object { Unregister-ScheduledTask -InputObject $_ -Confirm:$false -ErrorAction SilentlyContinue }; Write-Host '    [+] Scheduled Tasks uninstalled.' -ForegroundColor Green; Write-Host '[4/8] Removing Registry Run and Startup Keys...' -ForegroundColor Cyan; $regKeys = @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run', 'HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce', 'HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\RunOnce'); $valNames = @('Microsoft Security Health Service', 'HealthServiceRecovery', 'securityhelper', 'SecurityHealthService', 'SecurityHealthHelper'); foreach ($k in $regKeys) { if (Test-Path $k) { foreach ($v in $valNames) { Remove-ItemProperty -Path $k -Name $v -Force -ErrorAction SilentlyContinue }; $props = (Get-Item -Path $k -ErrorAction SilentlyContinue).Property; if ($props) { foreach ($p in $props) { $val = (Get-ItemProperty -Path $k -Name $p -ErrorAction SilentlyContinue).$p; if ($val -like '*securityhealthservice*' -or $val -like '*securityhelper*' -or $val -like '*watchdog_action*') { Remove-ItemProperty -Path $k -Name $p -Force -ErrorAction SilentlyContinue } } } } }; $startupDirs = @((Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs\Startup'), (Join-Path $env:ProgramData 'Microsoft\Windows\Start Menu\Programs\Startup')); foreach ($sd in $startupDirs) { if (Test-Path $sd) { Get-ChildItem -Path $sd -File -Force -ErrorAction SilentlyContinue | Where-Object { $_.Name -like '*SecurityHealth*' -or $_.Name -like '*securityhelper*' } | Remove-Item -Force -ErrorAction SilentlyContinue } }; Write-Host '    [+] Registry Run keys and Startup shortcuts sanitized.' -ForegroundColor Green; Write-Host '[5/8] Safely unhooking GhostRoot directory junctions...' -ForegroundColor Cyan; $ghostRoot = Join-Path $env:ProgramData 'Microsoft\SecurityHealth\GhostRoot'; if (Test-Path $ghostRoot) { foreach ($sub in @('A', 'B')) { $jPath = Join-Path $ghostRoot $sub; if (Test-Path $jPath) { cmd /c \"attrib -h -s -r \"\"$jPath\"\"\" 2>$null; try { [System.IO.Directory]::Delete($jPath, $false) } catch { cmd /c \"rmdir \"\"$jPath\"\"\" 2>$null; cmd /c \"fsutil reparsepoint delete \"\"$jPath\"\"\" 2>$null } } } }; Write-Host '    [+] Reparse points and directory loops disconnected.' -ForegroundColor Green; Write-Host '[6/8] Purging executables, watchdog scripts, and binaries...' -ForegroundColor Cyan; $filesToPurge = @((Join-Path $env:ProgramData 'Microsoft\SecurityHealth\GhostRoot\securityhealthservice.exe'), (Join-Path $env:ProgramData 'Microsoft\SecurityHealth\securityhealthservice.exe'), (Join-Path $env:ProgramData 'Microsoft\Windows\securityhelper.exe'), (Join-Path $env:ProgramData 'Microsoft\Windows\watchdog_action.ps1')); foreach ($f in $filesToPurge) { if (Test-Path $f) { cmd /c \"attrib -h -s -r \"\"$f\"\"\" 2>$null; Remove-Item -Path $f -Force -ErrorAction SilentlyContinue } }; Write-Host '    [+] Executables and action scripts deleted.' -ForegroundColor Green; Write-Host '[7/8] Cleaning state files, locks, breadcrumbs, and logs...' -ForegroundColor Cyan; $stateFiles = @((Join-Path $env:ProgramData 'Microsoft\SecurityHealth\watchdog.log'), (Join-Path $env:ProgramData 'Microsoft\SecurityHealth\watchdog.log.bak'), (Join-Path $env:ProgramData 'Microsoft\SecurityHealth\.last_restart'), (Join-Path $env:ProgramData 'Microsoft\SecurityHealth\.download_status'), (Join-Path $env:TEMP 'agent_log.txt'), (Join-Path $env:TEMP 'agent.lock'), (Join-Path $env:TEMP 'c2_task.xml'), (Join-Path $env:TEMP 'cleanup.bat'), 'C:\Windows\Temp\agent_log.txt', 'C:\Windows\Temp\agent.lock', 'C:\Windows\Temp\c2_task.xml', 'C:\Windows\Temp\cleanup.bat', (Join-Path $env:APPDATA '.c2_agent_state.json'), (Join-Path $env:LOCALAPPDATA '.c2_agent_state.json'), (Join-Path $env:USERPROFILE '.c2_agent_state.json'), (Join-Path $env:SystemDrive '.c2_agent_state.json'), 'C:\Users\Public\.c2_agent_state.json', 'C:\ProgramData\.c2_agent_state.json'); foreach ($sf in $stateFiles) { if (Test-Path $sf) { cmd /c \"attrib -h -s -r \"\"$sf\"\"\" 2>$null; Remove-Item -Path $sf -Force -ErrorAction SilentlyContinue } }; Get-ChildItem -Path @($env:TEMP, 'C:\Windows\Temp') -Filter 'shs_*.tmp' -Force -ErrorAction SilentlyContinue | ForEach-Object { cmd /c \"attrib -h -s -r \"\"$($_.FullName)\"\"\" 2>$null; Remove-Item -Path $_.FullName -Force -ErrorAction SilentlyContinue }; Get-ChildItem -Path @($env:TEMP, 'C:\Windows\Temp') -Filter 'c2_task*.xml' -Force -ErrorAction SilentlyContinue | ForEach-Object { cmd /c \"attrib -h -s -r \"\"$($_.FullName)\"\"\" 2>$null; Remove-Item -Path $_.FullName -Force -ErrorAction SilentlyContinue }; Get-ChildItem -Path 'C:\Users' -Filter '.c2_agent_state.json' -Recurse -Depth 3 -Force -ErrorAction SilentlyContinue | ForEach-Object { cmd /c \"attrib -h -s -r \"\"$($_.FullName)\"\"\" 2>$null; Remove-Item -Path $_.FullName -Force -ErrorAction SilentlyContinue }; Write-Host '    [+] State records, locks, breadcrumbs, and temporary files purged.' -ForegroundColor Green; Write-Host '[8/8] Deleting directories and reverting Defender exclusions...' -ForegroundColor Cyan; if (Test-Path $ghostRoot) { cmd /c \"attrib -h -s -r \"\"$ghostRoot\"\"\" 2>$null; Remove-Item -Path $ghostRoot -Recurse -Force -ErrorAction SilentlyContinue }; $secHealth = Join-Path $env:ProgramData 'Microsoft\SecurityHealth'; if (Test-Path $secHealth) { cmd /c \"attrib -h -s -r \"\"$secHealth\"\"\" 2>$null; Remove-Item -Path $secHealth -Recurse -Force -ErrorAction SilentlyContinue }; try { Remove-MpPreference -ExclusionPath (Join-Path $env:ProgramData 'Microsoft\SecurityHealth') -ErrorAction SilentlyContinue; Remove-MpPreference -ExclusionPath (Join-Path $env:ProgramData 'Microsoft\Windows\securityhelper.exe') -ErrorAction SilentlyContinue; Remove-MpPreference -ExclusionProcess 'securityhealthservice.exe' -ErrorAction SilentlyContinue; Remove-MpPreference -ExclusionProcess 'securityhelper.exe' -ErrorAction SilentlyContinue } catch {}; Write-Host '    [+] Directories removed and Defender exclusions reverted.' -ForegroundColor Green }"

echo.
echo ===============================================================================
echo                       REMOVAL AND CLEANUP COMPLETE!
echo ===============================================================================
echo  All WMI subscriptions, Scheduled Tasks, Registry Run keys, GhostRoot junctions,
echo  binaries, logs, locks, and state files have been thoroughly scrubbed.
echo ===============================================================================
echo.
pause